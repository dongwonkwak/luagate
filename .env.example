# LuaGate environment variables
# Copy to .env and adjust values for your environment.

# Admin API bearer token (minimum 32 bytes)
LUAGATE_ADMIN_TOKEN=your-token-here-at-least-32-bytes-long

# UI development: Vite dev server (npm run dev) proxy target.
# In production (Docker build), UI uses same-origin "/api" prefix — no env var needed.
# Only set this when running Vite dev server outside Docker:
# VITE_ADMIN_API_URL=http://127.0.0.1:9090/api
